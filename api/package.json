{
  "name": "@church-directory/api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "DEV_AUTH_EMAIL=${DEV_AUTH_EMAIL-paul@example.com} DB_PASSWORD=${DB_PASSWORD-postgres} PHOTO_STORAGE=${PHOTO_STORAGE-local} COGNITO_MODE=${COGNITO_MODE-local} tsx watch src/server.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.799.0",
    "@aws-sdk/client-s3": "^3.799.0",
    "@aws-sdk/client-sesv2": "^3.1121.0",
    "@aws-sdk/cloudfront-signer": "^3.1116.0",
    "@aws-sdk/rds-signer": "^3.799.0",
    "@aws-sdk/s3-request-presigner": "^3.799.0",
    "@hono/node-server": "^2.1.1",
    "aws-jwt-verify": "^5.2.1",
    "hono": "^4.6.14",
    "pg": "^8.13.1",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
